# Public Supabase identifiers (safe for browser use by design)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret access (bypasses RLS; never expose with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

# Canonical platform URLs and tenant routing
APP_URL=http://localhost:3000
PLATFORM_ROOT_DOMAIN=localhost

# Transactional email
EMAIL_PROVIDER=development
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=

# Billing
BILLING_PROVIDER=development
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Spam protection
TURNSTILE_MODE=development
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Scheduled/background work
CRON_SECRET=

# Optional marketing analytics; never include lead PII in events
NEXT_PUBLIC_GA_MEASUREMENT_ID=
